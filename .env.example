# DealPilotAI environment template
#
# Profile A (offline developer preview)
#   DEMO_MODE=true
#   ENABLE_MERCHANT_CHECKOUT=true (catalog routes only without PayPal credentials)
#   ENABLE_EXTERNAL_AFFILIATE=false
#   COMMERCE_DATABASE_URL=sqlite:///./commerce.db
#   FLASK_SECRET_KEY=demo-only-insecure-secret
#   AI_PROVIDER=
#   no real PayPal or AI credentials required
#
# Profile B (full sandbox hackathon flow)
#   DEMO_MODE=false
#   PAYPAL_ENVIRONMENT=sandbox
#   ENABLE_MERCHANT_CHECKOUT=true
#   ENABLE_EXTERNAL_AFFILIATE=false
#   COMMERCE_DATABASE_URL=sqlite:///./commerce.db or postgresql://...
#   FLASK_SECRET_KEY=<strong random value>
#   AI_PROVIDER=openai or featherless
#   OPENAI_API_KEY=...
#   FEATHERLESS_API_KEY=...
#
# Copy the profile you need and set only the values that apply.

DEMO_MODE=true
FLASK_SECRET_KEY=demo-only-insecure-secret
PREFERRED_URL_SCHEME=http
ENABLE_MERCHANT_CHECKOUT=true
ENABLE_EXTERNAL_AFFILIATE=false
DISABLE_UNVERIFIED_AMAZON_SCRAPING=true
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD
APP_BASE_URL=http://127.0.0.1:5000
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
COMMERCE_DATABASE_URL=sqlite:///./commerce.db
DATABASE_URL=
DASHBOARD_TOKEN=
AMAZON_AFFILIATE_ID=
MAX_CART_TOTAL=500.00
CART_QUOTE_TTL_MINUTES=30
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ADMIN_USER_IDS=
DEFAULT_REGION=US
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
MAX_DEALS_PER_SOURCE=10
POST_INTERVAL_MINUTES=60
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=2
